APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
ASSET_VERSION=1.0.0
INTERNAL_API_TOKEN=
HRIS_ALLOWED_IP=

HRIS_API_BASE_URL=https://hris.vdnisite.com
HRIS_API_TOKEN=
HRIS_API_TIMEOUT=20
HRIS_API_QUEUE=default
PKWT_CONTRACT_DISK=local
PKWT_CONTRACT_BASE_PATH=pkwt-contracts
PKWT_CONTRACT_MAX_UPLOAD_KB=10240

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SECOND_DB_CONNECTION=mysql
SECOND_DB_HOST=
SECOND_DB_PORT=3306
SECOND_DB_DATABASE=
SECOND_DB_USERNAME=
SECOND_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@vdni.top
MAIL_FROM_NAME="${APP_NAME}"

MAIL_SECONDARY_MAILER=smtp_second
MAIL_HOST_SECOND=smtp-relay.brevo.com
MAIL_PORT_SECOND=587
MAIL_USERNAME_SECOND=
MAIL_PASSWORD_SECOND=
MAIL_ENCRYPTION_SECOND=tls
MAIL_FROM_ADDRESS_SECOND=
MAIL_FROM_NAME_SECOND="${APP_NAME}"

MAIL_RECOVERY_TO_ADDRESS=
MAIL_RECOVERY_TO_NAME="Tim Recruitment"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SWEET_ALERT_CONFIRM_DELETE_CONFIRM_BUTTON_TEXT='Iya, hapus data!'
SWEET_ALERT_CONFIRM_DELETE_CANCEL_BUTTON_TEXT='Tidak, batalkan!'
SWEET_ALERT_CONFIRM_DELETE_SHOW_CANCEL_BUTTON=true
SWEET_ALERT_CONFIRM_DELETE_SHOW_CLOSE_BUTTON=false
SWEET_ALERT_CONFIRM_DELETE_ICON='warning'
SWEET_ALERT_CONFIRM_DELETE_SHOW_LOADER_ON_CONFIRM=true

// Aksara OCR
OCR_API_TOKEN=""
OCR_API_LINK="https://contoh.com/ocr"
OCR_API_TYPE="ktp"
OCR_API_PATH="image"

// OCR Space
OCR_SPACE_API_KEY=""
OCR_SPACE_API_ENDPOINT="https://contoh.com/ocr"
OCR_SPACE_KTP_ENGINE=3
OCR_SPACE_SIM_B2_ENGINE=2
OCR_SPACE_TIMEOUT=30

FIREBASE_CREDENTIALS=firebase.json

QUEUE_CONNECTION=database

LOCKED_EMPLOYMENT_REFRESH_ENABLED=true
LOCKED_EMPLOYMENT_REFRESH_CRON="30 1 * * *"
LOCKED_EMPLOYMENT_REFRESH_RESYNC_AFTER_MINUTES=1440
LOCKED_EMPLOYMENT_REFRESH_CHUNK_SIZE=250
LOCKED_EMPLOYMENT_REFRESH_QUEUE=default
